  <diagram id="p7" name="7. Data Islands">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
      <mxCell id="p7-0" />
      <mxCell id="p7-1" parent="p7-0" />
      <mxCell id="p7-s1" value="create_island(name, pii_policy,
refresh_strategy, table_configs)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p7-1"><mxGeometry x="315" y="40" width="170" height="50" as="geometry" /></mxCell>
      <mxCell id="p7-p1" value="island_slug = slugify(name)[:50]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p7-1"><mxGeometry x="270" y="150" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-p2" value="persist DataIsland(status='draft')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p7-1"><mxGeometry x="270" y="260" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-d1" value="refresh_type ==
'scheduled'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="p7-1"><mxGeometry x="290" y="392" width="220" height="80" as="geometry" /></mxCell>
      <mxCell id="p7-p3" value="schedule_next_run:
cron → croniter().get_next()
frequency → now + timedelta(unit=every)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p7-1"><mxGeometry x="650" y="392" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-p4" value="ensure_island_schema:
CREATE SCHEMA/DATABASE IF NOT EXISTS di_{slug}
(failure only logged — DDL still attempted)" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="p7-1"><mxGeometry x="280" y="546" width="240" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-p5" value="FOR EACH table_config:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="p7-1"><mxGeometry x="270" y="689" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-p6" value="view_name = di_{slug}.{table_slug}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p7-1"><mxGeometry x="270" y="799" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-p7" value="build_table_sql: per column —
hide→omit / encrypt→MD5(col) / allow→as-is
+ refresh_time_expr + incremental WHERE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p7-1"><mxGeometry x="270" y="931" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-p8" value="execute_ddl: CREATE OR REPLACE VIEW
view_name AS sql" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="p7-1"><mxGeometry x="280" y="1085" width="240" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-d2" value="DDL
succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="p7-1"><mxGeometry x="290" y="1228" width="220" height="80" as="geometry" /></mxCell>
      <mxCell id="p7-p9" value="island_table.status = 'error'
record last_error — CONTINUE next table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p7-1"><mxGeometry x="650" y="1228" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-p10" value="island_table.status = 'active'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p7-1"><mxGeometry x="270" y="1371" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-p11" value="island.status = 'error' if any table
failed else 'active'" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p7-1"><mxGeometry x="315" y="1514" width="170" height="50" as="geometry" /></mxCell>
      <mxCell id="p7-n1" value="run-due (external cron) → refresh_island:
rebuild SQL with last_refresh_unix,
re-execute DDL per table, schedule_next_run again" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="p7-1"><mxGeometry x="-90" y="799" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-n2" value="delete_island_view:
DROP SCHEMA di_{slug} CASCADE (one statement)
metadata row ALWAYS deleted even if DDL fails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="p7-1"><mxGeometry x="-90" y="1085" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p7-e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-s1" target="p7-p1"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p7-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-p1" target="p7-p2"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p7-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-p2" target="p7-d1"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p7-e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-d1" target="p7-p3"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p7-e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-d1" target="p7-p4"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p7-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-p3" target="p7-p4"><mxGeometry relative="1" as="geometry" /></mxCell>
