      <mxCell id="p5-p7" value="prune — do not enqueue children" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p5-1"><mxGeometry x="650" y="1239" width="260" height="60" as="geometry" /></mxCell>
