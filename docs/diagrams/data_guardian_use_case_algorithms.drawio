      <mxCell id="p7-e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-d2" target="p7-p9"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p7-e12" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-d2" target="p7-p10"><mxGeometry relative="1" as="geometry" /></mxCell>
