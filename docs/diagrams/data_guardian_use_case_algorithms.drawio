      <mxCell id="p5-p2" value="resolved = flat list of identifiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p5-1"><mxGeometry x="270" y="458" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p5-p3" value="child_map = build_relationship_graph(datasource)
