      <mxCell id="p4-e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p4-1" source="p4-d1" target="p4-p6"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p4-e7" value="yes (skip)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p4-1" source="p4-d1" target="p4-e1"><mxGeometry relative="1" as="geometry" /></mxCell>
