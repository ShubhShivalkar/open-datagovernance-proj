      <mxCell id="p5-p6" value="row_pks = SELECT DISTINCT pk
WHERE col IN (values)" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="p5-1"><mxGeometry x="280" y="1096" width="240" height="60" as="geometry" /></mxCell>
      <mxCell id="p5-d3" value="row_pks
