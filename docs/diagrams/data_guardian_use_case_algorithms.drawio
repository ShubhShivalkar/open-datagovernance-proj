  <diagram id="p5" name="5. Full Erasure">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
      <mxCell id="p5-0" />
      <mxCell id="p5-1" parent="p5-0" />
      <mxCell id="p5-s1" value="Step 1: resolve_identifiers(request)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p5-1"><mxGeometry x="315" y="40" width="170" height="50" as="geometry" /></mxCell>
      <mxCell id="p5-d1" value="input_type ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="p5-1"><mxGeometry x="290" y="172" width="220" height="80" as="geometry" /></mxCell>
