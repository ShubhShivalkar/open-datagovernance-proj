  <diagram id="p4" name="4. Data Map Graph Build">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
      <mxCell id="p4-0" />
      <mxCell id="p4-1" parent="p4-0" />
      <mxCell id="p4-s1" value="Render Data Map / start BFS
(Erasure or DSAR)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p4-1"><mxGeometry x="315" y="40" width="170" height="50" as="geometry" /></mxCell>
      <mxCell id="p4-p1" value="child_map = {}
(parent_table → [(child, fk_col, parent_pk)])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p4-1"><mxGeometry x="270" y="150" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p4-p2" value="FOR EACH active RelationshipRule
of the datasource (manual or AI):" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="p4-1"><mxGeometry x="270" y="282" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p4-p3" value="child_map[rule.to_table].append(
(rule.from_table, from_column, to_column))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p4-1"><mxGeometry x="270" y="403" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p4-p4" value="latest_run = most recent completed
CatalogueRun for the datasource" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p4-1"><mxGeometry x="270" y="535" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p4-p5" value="FOR EACH ColumnCatalogue in latest_run
WHERE is_foreign_key = true:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="p4-1"><mxGeometry x="270" y="667" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p4-d1" value="Edge already covered
by a RelationshipRule?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="p4-1"><mxGeometry x="290" y="799" width="220" height="80" as="geometry" /></mxCell>
      <mxCell id="p4-p6" value="child_map[referenced_table].append(
(table, column, referenced_column))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p4-1"><mxGeometry x="650" y="799" width="260" height="60" as="geometry" /></mxCell>
      <mxCell id="p4-e1" value="Return child_map
→ rendered as nodes+edges in UI,
→ reused verbatim by Erasure/DSAR BFS" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p4-1"><mxGeometry x="315" y="942" width="170" height="50" as="geometry" /></mxCell>
