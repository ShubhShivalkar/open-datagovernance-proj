      <mxCell id="p7-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-p5" target="p7-p6"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="p7-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="p7-1" source="p7-p6" target="p7-p7"><mxGeometry relative="1" as="geometry" /></mxCell>
