# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Seeds a Django superuser (username "admin") on first migrate. Leave unset to
# skip seeding entirely — no default admin account will be created.
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@dataGuardian.local

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-here

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── AI Provider ───────────────────────────────────────────────────────────────
# Default: "ollama" (local, no API key required — install Ollama and run: ollama pull llama3.2)
# Override to "anthropic" or "openai" for cloud providers.
AI_PROVIDER=ollama

# Ollama uses a local server — no real key needed (any non-empty string works)
AI_API_KEY=ollama
# Optional: override the model (default: llama3.2 for ollama, claude-sonnet-4-6 for anthropic, gpt-4o for openai)
AI_MODEL=
# Optional: override the Ollama base URL (default: http://localhost:11434/v1)
# AI_BASE_URL=http://localhost:11434/v1

# ── Cloud provider overrides ──────────────────────────────────────────────────
# Uncomment and set AI_PROVIDER + AI_API_KEY to use a cloud provider instead:
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-your-key-here
#
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-key-here

# ── Email ─────────────────────────────────────────────────────────────────────
# Defaults to the console backend (prints to terminal). Set to the SMTP backend
# and fill in EMAIL_HOST_USER/EMAIL_HOST_PASSWORD for real delivery.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@dataGuardian.local
# CONTACT_EMAIL=hello@example.com

# Optional contact block appended to Query Editor result emails. One entry per
# line — separate lines with a literal "\n" inside the value. Omitted from the
# email entirely if left unset.
# TEAM_CONTACTS="Jane Doe   +1 555 0100   jane@example.com\nJohn Roe   +1 555 0101   john@example.com"
